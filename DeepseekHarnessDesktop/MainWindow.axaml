<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:DeepseekHarnessDesktop.ViewModels"
        xmlns:md="clr-namespace:LiveMarkdown.Avalonia;assembly=LiveMarkdown.Avalonia"
        x:Class="DeepseekHarnessDesktop.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        mc:Ignorable="d"
        d:DesignWidth="1280"
        d:DesignHeight="760"
        MinWidth="920"
        MinHeight="600"
        Width="1280"
        Height="760"
        Title="Deepseek Harness">
    <Window.Resources>
        <!-- 工具卡片模板：顶层（运行中的轮次）与过程组展开时复用。 -->
        <DataTemplate x:Key="ToolCardTemplate" x:DataType="vm:ToolActivityItemViewModel">
            <Border Classes="tool-card">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
                        <Panel Grid.Column="0" VerticalAlignment="Center" Width="8" Height="8">
                            <Ellipse Width="8" Height="8"
                                     Fill="{DynamicResource StatusRunningBrush}"
                                     IsVisible="{Binding IsRunning}" />
                            <Ellipse Width="8" Height="8"
                                     Fill="{DynamicResource StatusErrorBrush}"
                                     IsVisible="{Binding IsFailed}" />
                            <Ellipse Width="8" Height="8"
                                     Fill="{DynamicResource StatusConnectedBrush}"
                                     IsVisible="{Binding IsSucceeded}" />
                        </Panel>
                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentTextBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding StatusText}" Classes="caption"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="{Binding CreatedAtText}"
                                   Classes="caption" VerticalAlignment="Center" />
                        <Button Grid.Column="4" Classes="tool-toggle"
                                Content="{Binding DetailsToggleText}"
                                Command="{Binding ToggleDetailsCommand}"
                                IsVisible="{Binding HasDetails}"
                                VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel Spacing="8" IsVisible="{Binding IsExpanded}">
                        <Border Background="{DynamicResource ChatBackgroundBrush}"
                                CornerRadius="6" Padding="10,8" IsVisible="{Binding HasError}">
                            <TextBlock Text="{Binding ErrorReason}" FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource StatusErrorBrush}" />
                        </Border>
                        <StackPanel Spacing="4"
                                    IsVisible="{Binding ArgumentsText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="参数" Classes="caption" />
                            <TextBlock Classes="tool-mono" Text="{Binding ArgumentsPreview}" />
                        </StackPanel>
                        <StackPanel Spacing="4"
                                    IsVisible="{Binding ResultText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="结果" Classes="caption" />
                            <Border Background="{DynamicResource ChatBackgroundBrush}"
                                    CornerRadius="6" Padding="10,8" MaxHeight="320">
                                <TextBlock Classes="tool-mono" Text="{Binding ResultPreview}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- 消息气泡模板：主时间线与过程组内的中间消息复用。 -->
        <DataTemplate x:Key="MessageBubbleTemplate" x:DataType="vm:MessageItemViewModel">
            <Grid Margin="0,0,0,16">
                <Border Classes="message-bubble user-bubble" IsVisible="{Binding IsUserMessage}">
                    <StackPanel Spacing="7">
                        <TextBlock Text="{Binding RoleLabel}" Classes="caption"
                                   Foreground="{DynamicResource OnAccentMutedBrush}" />
                        <TextBlock Text="{Binding Content}" TextWrapping="Wrap" LineHeight="22"
                                   Foreground="{DynamicResource OnAccentBrush}" />
                        <TextBlock Text="{Binding CreatedAtText}" Classes="caption"
                                   HorizontalAlignment="Right"
                                   Foreground="{DynamicResource OnAccentMutedBrush}" />
                    </StackPanel>
                </Border>
                <Border Classes="message-bubble assistant-bubble"
                        IsVisible="{Binding IsAssistantMessage}">
                    <StackPanel Spacing="7">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding RoleLabel}" Classes="caption"
                                       Foreground="{DynamicResource AccentTextBrush}" />
                            <TextBlock Text="生成中…" Classes="caption"
                                       IsVisible="{Binding IsStreaming}" />
                            <TextBlock Text="已中断" Classes="caption"
                                       Foreground="{DynamicResource StatusErrorBrush}"
                                       IsVisible="{Binding IsInterrupted}" />
                        </StackPanel>
                        <!-- 思考行（reasoning）：默认收起显示首行摘要，展开显示全文；
                             纯思考消息（无正文）也复用本模板，正文区隐藏。 -->
                        <StackPanel Spacing="4" IsVisible="{Binding HasReasoning}">
                            <Button Classes="tool-toggle" Command="{Binding ToggleReasoningCommand}"
                                    HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="思考" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding ReasoningSummary}" Classes="caption"
                                               TextTrimming="CharacterEllipsis" MaxWidth="420"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding !IsReasoningExpanded}" />
                                    <Panel Width="8" Height="8" VerticalAlignment="Center">
                                        <Path Data="M0,0 L4,4 L0,8"
                                              Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.5"
                                              IsVisible="{Binding !IsReasoningExpanded}" />
                                        <Path Data="M0,4 L4,8 L8,4"
                                              Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.5"
                                              IsVisible="{Binding IsReasoningExpanded}" />
                                    </Panel>
                                </StackPanel>
                            </Button>
                            <Border Background="{DynamicResource PanelBackgroundBrush}"
                                    CornerRadius="6" Padding="10,8" MaxWidth="760" HorizontalAlignment="Left"
                                    IsVisible="{Binding IsReasoningExpanded}">
                                <TextBlock Text="{Binding Reasoning}" Classes="reason-body" />
                            </Border>
                        </StackPanel>
                        <!-- 助手内容按 Markdown 渲染，流式增量经 MarkdownBuilder 增量更新。 -->
                        <md:MarkdownRenderer MarkdownBuilder="{Binding MarkdownBuilder}"
                                             IsVisible="{Binding Content, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <TextBlock Text="{Binding CreatedAtText}" Classes="caption"
                                   IsVisible="{Binding Content, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                </Border>
                <Border Classes="message-bubble system-bubble"
                        IsVisible="{Binding IsSystemMessage}">
                    <TextBlock Text="{Binding Content}" Classes="caption" TextWrapping="Wrap" />
                </Border>
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <Window.Styles>
        <Style Selector="TextBlock.heading">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>
        <Style Selector="TextBlock.caption">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>
        <Style Selector="Border.message-bubble">
            <Setter Property="MaxWidth" Value="760" />
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>
        <Style Selector="Border.user-bubble">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Background" Value="{DynamicResource UserBubbleBrush}" />
        </Style>
        <!-- 助手回复不用气泡底色，直接融入聊天背景；仅保留对齐与可读宽度。 -->
        <Style Selector="Border.assistant-bubble">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.system-bubble">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
        </Style>
        <Style Selector="Border.tool-card">
            <Setter Property="MaxWidth" Value="760" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="TextBlock.tool-mono">
            <Setter Property="FontFamily" Value="Consolas, 'Courier New', monospace" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>
        <Style Selector="TextBlock.reason-body">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>
        <!-- 历史分页按钮：对齐参考 Web 客户端的「加载更早」手动分页。 -->
        <Style Selector="Button.load-older">
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.load-older:pointerover">
            <Setter Property="Background" Value="{DynamicResource SessionHoverBrush}" />
        </Style>
        <Style Selector="Button.tool-toggle">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style Selector="Button.tool-toggle:pointerover">
            <Setter Property="Background" Value="{DynamicResource SessionHoverBrush}" />
        </Style>
        <!-- 会话列表行与分组头行：自定义模板自绘 hover/选中高亮，
             点击分别驱动选择会话与展开收起（分组行不可选）。 -->
        <Style Selector="Button.session-row, Button.group-header">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border x:Name="PART_Surface" CornerRadius="10" Padding="{TemplateBinding Padding}"
                                Background="Transparent">
                            <!-- 自定义模板的 ContentPresenter 必须显式携带按钮内容，
                                 缺省绑定会把行内文字整体吞掉（只剩固定尺寸元素）。 -->
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="Button.session-row:pointerover /template/ Border#PART_Surface">
            <Setter Property="Background" Value="{DynamicResource SessionHoverBrush}" />
        </Style>
        <Style Selector="Button.session-row.current /template/ Border#PART_Surface">
            <Setter Property="Background" Value="{DynamicResource SessionSelectedBrush}" />
        </Style>
        <Style Selector="Button.group-header /template/ Border#PART_Surface">
            <Setter Property="Padding" Value="12,6" />
        </Style>
        <Style Selector="Button.group-header:pointerover /template/ Border#PART_Surface">
            <Setter Property="Background" Value="{DynamicResource SessionHoverBrush}" />
        </Style>
        <!-- 悬浮输入面板：圆角容器叠放在消息滚动区之上，高度随文本与错误提示增长。 -->
        <Style Selector="Border.composer-panel">
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <!-- 面板内输入框不自带边框与底色，视觉容器由悬浮面板承担。 -->
        <Style Selector="TextBox.composer-input">
            <Setter Property="MinHeight" Value="56" />
            <Setter Property="MaxHeight" Value="200" />
            <Setter Property="Padding" Value="6,12" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <!-- 工具栏圆形图标按钮（附件等占位）：Fluent 把状态底色画在模板 ContentPresenter 上，
             悬停/禁用态需覆盖该部件而非按钮的 Background。 -->
        <Style Selector="Button.composer-icon">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="17" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.composer-icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SessionHoverBrush}" />
        </Style>
        <Style Selector="Button.composer-icon:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <!-- 圆形发送按钮：常态用气泡强调色，悬停/禁用覆盖 Fluent 状态底色。 -->
        <Style Selector="Button.composer-send">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{DynamicResource UserBubbleBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.composer-send:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ComposerSendHoverBrush}" />
        </Style>
        <Style Selector="Button.composer-send:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource UserBubbleBrush}" />
        </Style>
        <Style Selector="Button.composer-send:disabled">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>
        <Style Selector="Button.composer-send:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SessionHoverBrush}" />
        </Style>
        <!-- 生成中的圆形停止按钮：中性底 + 描边，图标用错误色。 -->
        <Style Selector="Button.composer-stop">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource StatusErrorBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.composer-stop:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SessionHoverBrush}" />
        </Style>
        <Style Selector="Button.composer-stop:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SessionHoverBrush}" />
        </Style>
        <!-- 审批横幅：内嵌暗底卡片，等待态用运行色点缀。 -->
        <Style Selector="Border.approval-banner">
            <Setter Property="Background" Value="{DynamicResource ChatBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <!-- 裁决按钮：允许为气泡强调色实底，拒绝为描边幽灵按钮。 -->
        <Style Selector="Button.approval-allow">
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{DynamicResource UserBubbleBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="Button.approval-allow:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ComposerSendHoverBrush}" />
        </Style>
        <Style Selector="Button.approval-allow:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource UserBubbleBrush}" />
        </Style>
        <Style Selector="Button.approval-reject">
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="Button.approval-reject:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SessionHoverBrush}" />
        </Style>
        <!-- 模型下拉：面板内紧凑尺寸；展开列表沿用 Fluent 弹层。 -->
        <Style Selector="ComboBox.model-picker">
            <Setter Property="MinWidth" Value="200" />
            <Setter Property="MaxDropDownHeight" Value="360" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <!-- 库默认样式把 Markdown 文本固定为 Arial、14px；覆盖回应用字体与气泡正文字号。 -->
        <Style Selector="md|MarkdownTextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource FontFamilyNormal}" />
            <Setter Property="FontSize" Value="15" />
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="290,1*" RowDefinitions="*">
        <Border Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}" Padding="18,20,14,16">
            <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
                <StackPanel Spacing="4">
                    <TextBlock Text="DeepSeek Harness" Classes="heading" />
                    <TextBlock Text="原生桌面工作台" Classes="caption" />
                </StackPanel>

                <Button Grid.Row="1"
                        Margin="0,24,0,10"
                        HorizontalContentAlignment="Center"
                        Content="＋  新建会话"
                        Command="{Binding NewSessionCommand}" />

                <!-- 视图模式：单列表 / 按工作区（对齐参考 Web 客户端的视图选项）。 -->
                <Grid Grid.Row="2" Margin="0,0,0,8" ColumnDefinitions="*,Auto">
                    <TextBlock Text="会话" Classes="caption" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1"
                              MinWidth="100"
                              SelectedIndex="{Binding SessionListModeIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="单列表" />
                        <ComboBoxItem Content="按工作区" />
                    </ComboBox>
                </Grid>

                <ScrollViewer Grid.Row="3" Background="Transparent">
                    <ItemsControl ItemsSource="{Binding SessionRows}">
                        <ItemsControl.DataTemplates>
                            <DataTemplate x:DataType="vm:SessionGroupHeaderViewModel">
                                <Button Classes="group-header"
                                        Command="{Binding $parent[Window].DataContext.ToggleGroupCommand}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Panel Width="8" Height="8" VerticalAlignment="Center">
                                            <Path Data="M0,0 L4,4 L0,8"
                                                  Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.5"
                                                  IsVisible="{Binding !IsExpanded}" />
                                            <Path Data="M0,4 L4,8 L8,4"
                                                  Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.5"
                                                  IsVisible="{Binding IsExpanded}" />
                                        </Panel>
                                        <TextBlock Text="{Binding TitleText}" FontSize="13" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding CountText}" Classes="caption"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                            <DataTemplate x:DataType="vm:SessionItemViewModel">
                                <Button Classes="session-row"
                                        Classes.current="{Binding IsCurrent}"
                                        Command="{Binding $parent[Window].DataContext.SelectSessionCommand}"
                                        CommandParameter="{Binding}">
                                    <Grid ColumnDefinitions="*,Auto" RowSpacing="5">
                                        <TextBlock Grid.ColumnSpan="1"
                                                   Text="{Binding TitleText}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                            <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                                     Fill="{DynamicResource StatusRunningBrush}"
                                                     IsVisible="{Binding Running}" />
                                            <TextBlock Text="{Binding RunningText}" Classes="caption"
                                                       IsVisible="{Binding Running}" />
                                            <TextBlock Text="{Binding UpdatedText}" Classes="caption" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.DataTemplates>
                    </ItemsControl>
                </ScrollViewer>

                <Border Grid.Row="4"
                        Margin="0,16,0,0"
                        Padding="12"
                        Background="{DynamicResource PanelBackgroundBrush}"
                        CornerRadius="10">
                    <StackPanel Spacing="7">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                     Fill="{DynamicResource StatusConnectedBrush}"
                                     IsVisible="{Binding IsBackendConnected}" />
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                     Fill="{DynamicResource TextMutedBrush}"
                                     IsVisible="{Binding IsBackendDisconnected}" />
                            <TextBlock Text="{Binding BackendStatusText}" FontSize="12" />
                        </StackPanel>
                        <TextBlock Text="{Binding BackendErrorDetail}" Classes="caption" TextWrapping="Wrap"
                                   IsVisible="{Binding HasBackendError}" />
                        <TextBlock Text="{Binding SimulationNotice}" Classes="caption" TextWrapping="Wrap"
                                   IsVisible="{Binding IsSimulationMode}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Background="{DynamicResource ChatBackgroundBrush}" RowDefinitions="Auto,*">
            <Border Grid.Row="0" Padding="28,22" BorderBrush="{DynamicResource SubtleBorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding SelectedSession.TitleText, FallbackValue=选择一个会话}"
                                   Classes="heading" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding SelectedSession.Id}" Classes="caption" />
                            <TextBlock Text="生成中…" Classes="caption" Foreground="{DynamicResource StatusRunningBrush}"
                                       IsVisible="{Binding IsSessionRunning}" />
                        </StackPanel>
                    </StackPanel>
                    <Border Grid.Column="1" Background="{DynamicResource PanelBackgroundBrush}" CornerRadius="14"
                            Padding="12,7"
                            VerticalAlignment="Center">
                        <TextBlock Text="本地桌面" Classes="caption" />
                    </Border>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" x:Name="MessagesScroll" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <!-- 留白属于被滚动内容的一部分：挂在 ScrollViewer 上时 presenter 的 Padding
                     不计入 extent，滚到底也会截掉一段（气泡底部不可达）。
                     底部留白在 code-behind 随悬浮输入面板高度同步，避免面板遮住最后一条消息。 -->
                <Border x:Name="MessagesContent" Padding="28,22">
                    <StackPanel Spacing="8">
                        <!-- 历史分页按钮随内容滚动，位于时间线顶端；点击加载一页更早消息。 -->
                        <Button Classes="load-older"
                                Content="{Binding LoadOlderText}"
                                Command="{Binding LoadOlderCommand}"
                                HorizontalAlignment="Center"
                                IsVisible="{Binding HasMoreHistory}" />
                        <ItemsControl ItemsSource="{Binding ConversationItems}">
                            <ItemsControl.DataTemplates>
                                <DataTemplate x:DataType="vm:MessageItemViewModel">
                                    <ContentPresenter Content="{Binding}"
                                                      ContentTemplate="{StaticResource MessageBubbleTemplate}" />
                                </DataTemplate>
                                <DataTemplate x:DataType="vm:ToolActivityItemViewModel">
                                    <!-- 运行中轮次的工具卡片：turn/end 后折叠进过程组。 -->
                                    <ContentPresenter Content="{Binding}"
                                                      ContentTemplate="{StaticResource ToolCardTemplate}" />
                                </DataTemplate>
                                <DataTemplate x:DataType="vm:TurnProcessGroupViewModel">
                                    <StackPanel Margin="0,0,0,16" Spacing="6">
                                        <Button Classes="tool-toggle" Command="{Binding ToggleCommand}"
                                                HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding SummaryText}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding FailedText}" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource StatusErrorBrush}"
                                                           IsVisible="{Binding HasFailed}" />
                                                <!-- 折叠指示箭头：收起时向右，展开时向下。 -->
                                                <Panel Width="8" Height="8" VerticalAlignment="Center">
                                                    <Path Data="M0,0 L4,4 L0,8"
                                                          Stroke="{DynamicResource TextMutedBrush}"
                                                          StrokeThickness="1.5"
                                                          IsVisible="{Binding !IsExpanded}" />
                                                    <Path Data="M0,4 L4,8 L8,4"
                                                          Stroke="{DynamicResource TextMutedBrush}"
                                                          StrokeThickness="1.5"
                                                          IsVisible="{Binding IsExpanded}" />
                                                </Panel>
                                            </StackPanel>
                                        </Button>
                                        <ItemsControl ItemsSource="{Binding Process}"
                                                      IsVisible="{Binding IsExpanded}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Spacing="6" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.DataTemplates>
                                                <DataTemplate x:DataType="vm:ToolActivityItemViewModel">
                                                    <ContentPresenter Content="{Binding}"
                                                                      ContentTemplate="{StaticResource ToolCardTemplate}" />
                                                </DataTemplate>
                                                <DataTemplate x:DataType="vm:MessageItemViewModel">
                                                    <ContentPresenter Content="{Binding}"
                                                                      ContentTemplate="{StaticResource MessageBubbleTemplate}" />
                                                </DataTemplate>
                                            </ItemsControl.DataTemplates>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.DataTemplates>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </ScrollViewer>

            <!-- 悬浮输入面板：与消息滚动区同格叠放（ZIndex + 底部对齐）覆盖在消息之上。
                 左侧工具栏与底部统计栏是视觉占位：附件与统计的协议链路未接入，
                 保持禁用或以 — 展示，不伪装成可用功能。 -->
            <Border x:Name="ComposerPanel"
                    Grid.Row="1"
                    ZIndex="10"
                    Classes="composer-panel"
                    VerticalAlignment="Bottom"
                    Margin="28,0,28,18">
                <StackPanel Spacing="8">
                    <!-- 审批横幅：选中会话的待决 approval/request 瀑布，裁决经 $events/result 回执。 -->
                    <ItemsControl ItemsSource="{Binding SessionPendingApprovals}"
                                  IsVisible="{Binding HasSessionPendingApprovals}">
                        <ItemsControl.DataTemplates>
                            <DataTemplate x:DataType="vm:PendingApprovalViewModel">
                                <Border Classes="approval-banner" Margin="0,0,0,4">
                                    <StackPanel Spacing="7">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                     Fill="{DynamicResource StatusRunningBrush}" />
                                            <TextBlock Text="等待授权" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource StatusRunningBrush}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding ToolNameText}" Classes="tool-mono"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding HeadlineText}" FontSize="13"
                                                   TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                            <Button Classes="approval-reject"
                                                    Content="拒绝"
                                                    Command="{Binding $parent[Window].DataContext.RejectApprovalCommand}"
                                                    CommandParameter="{Binding}" />
                                            <Button Classes="approval-allow"
                                                    Content="允许一次"
                                                    Command="{Binding $parent[Window].DataContext.ApproveApprovalCommand}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.DataTemplates>
                    </ItemsControl>
                    <TextBlock Text="{Binding ErrorText}"
                               IsVisible="{Binding HasError}"
                               Foreground="{DynamicResource StatusErrorBrush}"
                               TextWrapping="Wrap" />
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <Button Classes="composer-icon"
                                IsEnabled="False"
                                VerticalAlignment="Bottom"
                                ToolTip.Tip="附件功能尚未接入">
                            <Viewbox Width="16" Height="16">
                                <Path Data="M12 5v14M5 12h14"
                                      Stroke="{Binding $parent[Button].Foreground}"
                                      StrokeThickness="2" />
                            </Viewbox>
                        </Button>
                        <TextBox Grid.Column="1"
                                 x:Name="MessageInput"
                                 Classes="composer-input"
                                 Text="{Binding DraftMessage, Mode=TwoWay}"
                                 PlaceholderText="输入消息…"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
                        <!-- 右侧区域：模型选择与发送/停止。目录与当前选型来自后端（follow 回声权威）。 -->
                        <StackPanel Grid.Column="2" Orientation="Vertical" Spacing="8"
                                    VerticalAlignment="Bottom">
                            <ComboBox Classes="model-picker"
                                      HorizontalAlignment="Right"
                                      ItemsSource="{Binding ModelOptions}"
                                      SelectedItem="{Binding SelectedModelOption, Mode=TwoWay}"
                                      IsEnabled="{Binding IsModelPickerEnabled}"
                                      ToolTip.Tip="切换当前会话的模型">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ModelOptionViewModel">
                                        <TextBlock Text="{Binding DisplayText}" FontSize="13"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Panel Width="44" Height="44" HorizontalAlignment="Right">
                                <Button Classes="composer-stop"
                                        Command="{Binding CancelCommand}"
                                        IsVisible="{Binding IsSessionRunning}"
                                        ToolTip.Tip="停止生成">
                                    <Viewbox Width="16" Height="16">
                                        <Path
                                            Data="M8 6H16A2 2 0 0 1 18 8V16A2 2 0 0 1 16 18H8A2 2 0 0 1 6 16V8A2 2 0 0 1 8 6Z"
                                            Fill="{Binding $parent[Button].Foreground}" />
                                    </Viewbox>
                                </Button>
                                <Button Classes="composer-send"
                                        Command="{Binding SendMessageCommand}"
                                        IsVisible="{Binding !IsSessionRunning}"
                                        ToolTip.Tip="发送">
                                    <Viewbox Width="18" Height="18">
                                        <Path Data="M12 19V5M5 12l7-7 7 7"
                                              Stroke="{Binding $parent[Button].Foreground}"
                                              StrokeThickness="2" />
                                    </Viewbox>
                                </Button>
                            </Panel>
                        </StackPanel>
                    </Grid>
                    <!-- 底部统计栏：whole-log 投影的累计值（token 四桶、缓存命中率、解码速度），
                         明细悬停展示；无数据时保持 — 占位。 -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="14"
                                    ToolTip.Tip="{Binding UsageDetailText}">
                            <TextBlock Text="{Binding UsageValueText}" Classes="caption" />
                            <TextBlock Text="{Binding CacheHitValueText}" Classes="caption" />
                            <TextBlock Text="{Binding SpeedValueText}" Classes="caption"
                                       ToolTip.Tip="{Binding StatsDetailText}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="Enter 发送 · Shift+Enter 换行" Classes="caption" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
